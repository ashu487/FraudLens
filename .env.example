# Copy to .env (never commit .env)
APP_ENV=local
GCP_PROJECT=fraud-local
PUBSUB_EMULATOR_HOST=pubsub:8085
PUBSUB_TOPIC=transactions
PUBSUB_SUBSCRIPTION=transactions-scoring
QUEUE_BACKEND=pubsub        # pubsub | local
STORAGE_BACKEND=duckdb      # duckdb | bigquery
DUCKDB_PATH=/data/fraud.duckdb
SIM_RATE_PER_SEC=5
