# Copy to .env (never commit .env)
APP_ENV=local
GCP_PROJECT=fraud-local
PUBSUB_EMULATOR_HOST=pubsub:8085
PUBSUB_TOPIC=transactions
PUBSUB_SUBSCRIPTION=transactions-scoring
QUEUE_BACKEND=pubsub
STORAGE_BACKEND=duckdb
DUCKDB_PATH=/data/fraud.duckdb

# simulator
PAYSIM_CSV=/data/PS_20174392719_1491204439457_log.csv
SIM_RATE_PER_SEC=5
SIM_FRAUD_RATIO=0.05
SIM_LEGIT_SAMPLE=0.01
SIM_DUPLICATE_RATE=0.02
SIM_BAD_RATE=0.01
